{
  "name": "claude-ai-proxy",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "proxy-auth": "./bin/proxy-auth"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && SYSTEM_PROMPT_PATH=./data/system_prompt.json node --test tests/*.test.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "bash setup.sh",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "ajv": "8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
