API_KEY=sk-your-proxy-key
DEFAULT_MODEL=claude-sonnet-4-6
PORT=4181
# Compose volume source; container PROXY_AUTH_DIR remains /data.
PROXY_AUTH_VOLUME=claude-proxy-data
# For local CLI use, optionally set PROXY_AUTH_DIR to a private user-owned directory.
ACCOUNT_UUID=your-account-uuid
DEVICE_ID=your-device-id-hex
SYSTEM_PROMPT_PATH=/data/system_prompt.json
