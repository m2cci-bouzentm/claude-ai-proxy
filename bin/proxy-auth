#!/usr/bin/env node
const { runImport, runLogin, runStatus, runTokenWizardImport } = require('../dist/cli.js');

function usage(exitCode = 1) {
  process.stderr.write(`Usage: proxy-auth <command> [options]

Commands:
  login                              Interactive setup: browser/SSO/Console login or token paste
  login --browser [--email <email>]  Start native Claude subscription login
  login --sso [--email <email>]      Start native Claude SSO login
  login --console [--email <email>]  Start Anthropic Console login
  import                             Interactively paste token fields one by one
  import --file <path> | -           Import native/normalized credential JSON
  status                             Print credential metadata (never secrets)
`);
  process.exit(exitCode);
}

function askLine(prompt, hidden = false) {
  return new Promise((resolve, reject) => {
    if (!process.stdin.isTTY || !process.stderr.isTTY || typeof process.stdin.setRawMode !== 'function') {
      reject(new Error("Interactive setup requires a TTY; use 'import --file <path>' or 'import -' for automation"));
      return;
    }
    process.stderr.write(prompt);
    const previousRaw = process.stdin.isRaw;
    let value = '';
    const cleanup = () => {
      process.stdin.off('data', onData);
      process.stdin.setRawMode(previousRaw);
      process.stdin.pause();
    };
    const finish = () => { cleanup(); process.stderr.write('\n'); resolve(value); };
    const onData = (chunk) => {
      for (const ch of String(chunk)) {
        if (ch === '\r' || ch === '\n') { finish(); return; }
        if (ch === '\u0003') { cleanup(); process.stderr.write('\n'); reject(new Error('Cancelled')); return; }
        if (ch === '\u007f' || ch === '\b') {
          if (value) { value = value.slice(0, -1); if (!hidden) process.stderr.write('\b \b'); }
          continue;
        }
        if (ch >= ' ') { value += ch; if (!hidden) process.stderr.write(ch); }
      }
    };
    process.stdin.setEncoding('utf8');
    process.stdin.setRawMode(true);
    process.stdin.resume();
    process.stdin.on('data', onData);
  });
}

async function tokenWizard() {
  process.stderr.write('\nPaste Claude credentials. Values are saved to /data/auth.json.\nTokens stay hidden; leave either token blank if unavailable.\n');
  const access = await askLine('Access token (hidden, optional): ', true);
  const refresh = await askLine('Refresh token (hidden, optional): ', true);
  if (!access.trim() && !refresh.trim()) throw new Error('At least one access or refresh token is required');
  const expires = await askLine('Expiry ISO time / epoch seconds / epoch ms (blank with refresh token = refresh now): ');
  return runTokenWizardImport({ access, refresh, expires });
}

async function interactiveLogin() {
  process.stderr.write('\nClaude authentication\n  1) Browser login\n  2) SSO login\n  3) Anthropic Console login\n  4) Paste access/refresh tokens\n');
  const choice = await askLine('Choose [1-4]: ');
  if (choice === '1') return runLogin({ browser: true });
  if (choice === '2') return runLogin({ browser: true, sso: true });
  if (choice === '3') return runLogin({ browser: true, console: true });
  if (choice === '4') return tokenWizard();
  throw new Error('Invalid choice');
}

async function main() {
  const args = process.argv.slice(2);
  const command = args[0];
  if (!command || ['--help', '-h', 'help'].includes(command)) usage(command ? 0 : 1);
  let status;
  if (command === 'status') {
    if (args.length !== 1) throw new Error('status accepts no options');
    status = runStatus();
  } else if (command === 'import') {
    let source = '';
    for (let i = 1; i < args.length; i++) {
      if (args[i] === '--file' && args[i + 1]) source = args[++i];
      else if (args[i] === '-') source = '-';
      else throw new Error(`Unknown import option: ${args[i]}`);
    }
    status = source ? runImport(source) : await tokenWizard();
  } else if (command === 'login') {
    const options = { browser: true, sso: false, console: false, email: undefined };
    let explicit = false;
    for (let i = 1; i < args.length; i++) {
      if (args[i] === '--browser') { options.browser = true; explicit = true; }
      else if (args[i] === '--sso') { options.sso = true; explicit = true; }
      else if (args[i] === '--console') { options.console = true; explicit = true; }
      else if (args[i] === '--email' && args[i + 1]) { options.email = args[++i]; explicit = true; }
      else throw new Error(`Unknown login option: ${args[i]}`);
    }
    status = explicit ? runLogin(options) : await interactiveLogin();
  } else {
    throw new Error(`Unknown command: ${command}`);
  }
  process.stdout.write(JSON.stringify({ ...(command === 'status' ? {} : { success: true }), ...status }, null, 2) + '\n');
}

main().catch((err) => { process.stderr.write(`Error: ${err.message}\n`); process.exit(1); });
